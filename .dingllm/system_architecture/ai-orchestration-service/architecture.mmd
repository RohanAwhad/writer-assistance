classDiagram
    %% Data Transfer Objects (DTOs) / Structs
    class TaskRequest {
        <<DTO>>
        +String task_type
        +String project_id
        +String content
        +Map params
    }

    class TokenUsage {
        <<Struct>>
        +int prompt_tokens
        +int completion_tokens
    }

    class TaskResponse {
        <<DTO>>
        +String status
        +Any data
        +TokenUsage usage
        +String error_message
    }

    %% Core Interface
    class ITaskEngine {
        <<interface>>
        +execute(req: TaskRequest): TaskResponse
    }

    %% Entry Point
    class ServiceRouter {
        -engines: Map~String, ITaskEngine~
        +handleRequest(req: TaskRequest): TaskResponse
        -routeToEngine(type: String): ITaskEngine
    }

    %% Concrete Implementations
    class LensGenerator {
        +execute(req: TaskRequest): TaskResponse
    }
    class DraftCompiler {
        +execute(req: TaskRequest): TaskResponse
    }
    class ToneEngine {
        +execute(req: TaskRequest): TaskResponse
    }
    class CritiqueEngine {
        +execute(req: TaskRequest): TaskResponse
    }

    %% Utilities
    class PromptManager {
        -templateStore: Database
        +getTemplate(taskType: String): String
        +injectVariables(template: String, vars: Map): String
    }
    
    class RAGEngine {
        -vectorDB: ChromaClient
        +chunkAndEmbed(text: String): void
        +getRelevantContext(projectId: UUID, query: String): List~String~
    }

    class LLMAdapter {
        -openAIKey: String
        -anthropicKey: String
        +generateResponse(prompt: String, provider: String): JSON
        -handleRateLimits(): void
    }

    %% Core Execution Relationships
    ServiceRouter --> ITaskEngine : routes to
    
    ITaskEngine <|.. LensGenerator : implements
    ITaskEngine <|.. DraftCompiler : implements
    ITaskEngine <|.. ToneEngine : implements
    ITaskEngine <|.. CritiqueEngine : implements

    %% DTO Relationships
    ITaskEngine ..> TaskRequest : receives
    ITaskEngine ..> TaskResponse : returns
    TaskResponse *-- TokenUsage : contains

    %% Utility Dependencies (Engines rely on these)
    ITaskEngine ..> PromptManager : uses
    ITaskEngine ..> RAGEngine : uses
    ITaskEngine ..> LLMAdapter : uses
