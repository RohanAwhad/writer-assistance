# Copy to .env and adjust. .env takes precedence over shell env vars
# (load_dotenv(override=True) in app/main.py). Never commit .env.
ANTHROPIC_VERTEX_PROJECT_ID=
GOOGLE_VERTEX_LOCATION=
VERTEX_LOCATION=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_SMALL_FAST_MODEL=
VERTEX_ACCESS_TOKEN=
ANTHROPIC_BASE_URL=
# DeepSeek provider (R-072): DEEPSEEK_API_KEY is required when a project
# selects 'deepseek'; DEEPSEEK_MODEL defaults to deepseek-v4-flash when unset (R-073).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Auth gate (R-075, INT-006): set to a long random value to enable the login gate,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`. Empty/unset
# keeps the key-less local flow (SD-24). When set, every request except the login
# surface requires a session cookie; the same value is the login key.
AUTH_API_KEY=
WRITER_ASSISTANCE_DB=
